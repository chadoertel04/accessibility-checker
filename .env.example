# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Google Maps JavaScript API key.
# Obtain one from https://console.cloud.google.com/
# Required APIs: Maps JavaScript API, Places API
VITE_GOOGLE_API_KEY=

# PostgreSQL Database Configuration (optional - defaults shown)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=accessibility_db
# POSTGRES_PORT=5432

# Keycloak Configuration (optional - defaults shown)
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_DB=keycloak
# KEYCLOAK_PORT=8080
# KEYCLOAK_HEALTH_PORT=9000

# Frontend Keycloak OIDC settings (required for app authentication)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=accessibility-app
VITE_KEYCLOAK_CLIENT_ID=accessibility-checker

# Accessibility review API (server/) - optional, defaults shown
# API_PORT=3001
# API_ALLOWED_ORIGINS=http://localhost:5173
# Behind a reverse proxy set the hop count (1 behind Caddy) so rate limits see visitors' IPs.
# API_TRUST_PROXY=false
# POSTGRES_HOST=localhost
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/accessibility_db
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=accessibility-app

# Base URL the frontend uses to reach the review API.
# Leave unset to use the Vite dev proxy at /api.
# VITE_REVIEWS_API_URL=http://localhost:3001/api
