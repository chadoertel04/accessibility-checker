# Written to the server by .github/workflows/deploy-backend.yml on every deploy.
# Copy to .env only when running this stack by hand on the server.

# Public hostnames; their DNS A/AAAA records must point at the server.
KEYCLOAK_DOMAIN=auth.example.com
API_DOMAIN=api.example.com

# The deployed frontend (GitHub Pages). APP_URL has no trailing slash.
APP_URL=https://chadoertel04.github.io/accessibility-checker
APP_ORIGIN=https://chadoertel04.github.io

# Long random hex values: `openssl rand -hex 32`. (Hex, because REVIEWS_DB_PASSWORD
# goes into a postgres:// URL, where characters like / + @ would break it.)
# Database passwords are fixed by the first start; changing one later needs ALTER USER in Postgres.
KEYCLOAK_DB_PASSWORD=
REVIEWS_DB_PASSWORD=
# Only used on the first start to create the "admin" account; change it in the console afterwards.
KEYCLOAK_ADMIN_PASSWORD=
